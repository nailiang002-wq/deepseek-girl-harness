{
  "name": "@local/dsh-deepseek-girl",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek 娘：三套服装、白饭互动、余额与本机今日费用预估和 Token 用量。",
  "icon": "./icon.png",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "projection.js",
    "logic.js",
    "client.js",
    "cordis.patch.yml",
    "icon.png",
    "locale",
    "README.md",
    "client.template.js",
    "README.en.md",
    "docs/images",
    "assets/fonts",
    "screenshots.json",
    "usage.js",
    "finance-host.js",
    "finance-protocol.js",
    "finance-client.js"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "node tests/logic.mjs && node tests/client.cjs && node tests/greetings.cjs && node tests/artwork.cjs && node tests/usage.mjs && node tests/finance-host.mjs",
    "test:browser": "node scripts/build.cjs && node tests/browser.cjs && node tests/greeting-browser.cjs && node tests/petting-browser.cjs && node tests/wardrobe-browser.cjs && node tests/finance-browser.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "sharp": "0.35.5",
    "playwright": "1.62.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
